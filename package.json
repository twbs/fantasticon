{
  "name": "@ernstc/fantasticon",
  "version": "0.0.0",
  "description": "Icon font generation tool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ernstc/fantasticon.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "icons",
    "fonts",
    "iconfonts",
    "svg",
    "vector"
  ],
  "author": "Tancredi Trugenberger",
  "bugs": {
    "url": "https://github.com/ernstc/fantasticon/issues"
  },
  "homepage": "https://github.com/ernstc/fantasticon#readme",
  "main": "lib/index.js",
  "bin": {
    "fantasticon": "bin/fantasticon"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "build": "rimraf lib && tsc --project ./tsconfig.json",
    "watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit --project tsconfig.test.json --noEmit",
    "lint": "prettier --check .",
    "fix": "prettier --write ."
  },
  "files": [
    "bin/fantasticon",
    "lib/**/*.{js,ts,map}",
    "!lib/**/{__mocks__,__tests__}/",
    "templates/*.hbs"
  ],
  "prepublish": "build",
  "dependencies": {
    "case": "^1.6.3",
    "commander": "^15.0.0",
    "figures": "^6.1.0",
    "glob": "^13.0.6",
    "handlebars": "^4.7.9",
    "picocolors": "^1.1.1",
    "slugify": "^1.6.9",
    "svg2ttf": "^6.1.0",
    "svgicons2svgfont": "^16.0.0",
    "ttf2eot": "^3.1.0",
    "ttf2woff": "^3.0.0",
    "ttf2woff2": "^8.0.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.46",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@types/svg2ttf": "^5.0.3",
    "@types/ttf2eot": "^2.0.2",
    "@types/ttf2woff": "^2.0.4",
    "jest": "^30.4.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.14.0"
  }
}
